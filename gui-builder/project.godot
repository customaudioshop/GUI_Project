; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="GUI Builder"
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[audio]

driver/driver="Dummy"

[autoload]

App="*res://scripts/app.gd"

[display]

window/size/viewport_width=3840
window/size/viewport_height=1440
window/size/mode=2
window/stretch/aspect="expand"
window/dpi/allow_hidpi=false

[dotnet]

project/assembly_name="GUI_Builder"

[gui]

theme/custom="res://theme/app_theme.tres"
theme/custom_font="res://gui_core/fonts/noto_sans_kr_normal.tres"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.117647, 0.121569, 0.133333, 1)
